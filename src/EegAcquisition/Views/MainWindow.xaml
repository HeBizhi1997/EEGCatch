<Window x:Class="EegAcquisition.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:converters="clr-namespace:EegAcquisition.Converters"
        Title="脑电数据采集系统" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        xml:lang="zh-CN"
        FontFamily="Microsoft YaHei"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:RecordingColorConverter x:Key="RecordingColorConverter"/>

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top: Connection and Control Panel -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="4">
            <WrapPanel VerticalAlignment="Center">
                <!-- Serial Port Selection -->
                <GroupBox Header="串口设置" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="串口:" VerticalAlignment="Center" Margin="4,0"/>
                        <ComboBox Width="100" Margin="4,0"
                                  ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPort}"
                                  IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Content="刷新" Style="{StaticResource ButtonStyle}"
                                Command="{Binding RefreshPortsCommand}"
                                IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Connection Control -->
                <GroupBox Header="连接控制" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="连接" Command="{Binding ConnectCommand}"
                                Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="断开" Command="{Binding DisconnectCommand}"
                                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisConverter}}"/>
                        <!-- Connection indicator -->
                        <Ellipse Width="12" Height="12" Margin="8,0"
                                 Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Recording Control -->
                <GroupBox Header="录制控制" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="开始录制" Command="{Binding StartRecordingCommand}"
                                IsEnabled="{Binding IsConnected}"/>
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="停止录制" Command="{Binding StopRecordingCommand}"
                                IsEnabled="{Binding IsRecording}"/>
                        <TextBlock Text="{Binding RecordingDuration}" VerticalAlignment="Center"
                                   Margin="8,0" FontFamily="Consolas" FontSize="14"
                                   Foreground="{Binding IsRecording, Converter={StaticResource RecordingColorConverter}}"/>
                    </StackPanel>
                </GroupBox>

                <!-- Simulation Control -->
                <GroupBox Header="模拟测试" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="开始模拟" Command="{Binding StartSimulationCommand}"
                                Visibility="{Binding IsSimulating, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="停止模拟" Command="{Binding StopSimulationCommand}"
                                Visibility="{Binding IsSimulating, Converter={StaticResource BoolToVisConverter}}"/>
                        <Ellipse Width="12" Height="12" Margin="8,0"
                                 Visibility="{Binding IsSimulating, Converter={StaticResource BoolToVisConverter}}"
                                 Fill="Orange"/>
                    </StackPanel>
                </GroupBox>

                <!-- Filter Control -->
                <GroupBox Header="信号滤波" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonStyle}"
                                Command="{Binding ToggleFilterCommand}"
                                Content="{Binding IsFilterEnabled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='关闭滤波|开启滤波'}"/>
                        <CheckBox Content="50Hz陷波" VerticalAlignment="Center" Margin="6,0"
                                  IsChecked="{Binding IsNotchEnabled}"
                                  IsEnabled="{Binding IsFilterEnabled}"
                                  Command="{Binding UpdateFilterSettingsCommand}"/>
                        <CheckBox Content="0.5-45Hz带通" VerticalAlignment="Center" Margin="6,0"
                                  IsChecked="{Binding IsBandpassEnabled}"
                                  IsEnabled="{Binding IsFilterEnabled}"
                                  Command="{Binding UpdateFilterSettingsCommand}"/>
                        <Ellipse Width="12" Height="12" Margin="6,0"
                                 Visibility="{Binding IsFilterEnabled, Converter={StaticResource BoolToVisConverter}}"
                                 Fill="#9C27B0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Display Settings -->
                <GroupBox Header="显示设置" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="时间窗口:" VerticalAlignment="Center" Margin="4,0"/>
                        <ComboBox Width="70" Margin="4,0"
                                  SelectedIndex="{Binding DisplayWindowIndex}">
                            <ComboBoxItem Content="5秒"/>
                            <ComboBoxItem Content="10秒"/>
                            <ComboBoxItem Content="30秒"/>
                            <ComboBoxItem Content="60秒"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <!-- Pulse Sensor -->
                <GroupBox Header="脉搏传感器 (HKG-07D)" Style="{StaticResource GroupBoxStyle}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="串口:" VerticalAlignment="Center" Margin="4,0"/>
                        <ComboBox Width="90" Margin="4,0"
                                  ItemsSource="{Binding AvailablePorts}"
                                  SelectedItem="{Binding SelectedPulsePort}"
                                  IsEnabled="{Binding IsPulseConnected, Converter={StaticResource InverseBoolConverter}}"/>
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="连接" Command="{Binding ConnectPulseCommand}"
                                Visibility="{Binding IsPulseConnected, Converter={StaticResource InverseBoolToVisConverter}}"/>
                        <Button Style="{StaticResource ButtonStyle}"
                                Content="断开" Command="{Binding DisconnectPulseCommand}"
                                Visibility="{Binding IsPulseConnected, Converter={StaticResource BoolToVisConverter}}"/>
                        <Ellipse Width="12" Height="12" Margin="6,0"
                                 Fill="{Binding IsPulseConnected, Converter={StaticResource BoolToColorConverter}}"/>
                        <!-- 轮询开关：连接后才可用 -->
                        <Button Style="{StaticResource ButtonStyle}"
                                Command="{Binding TogglePulsePollingCommand}"
                                IsEnabled="{Binding IsPulseConnected}"
                                Content="{Binding IsPulsePolling, Converter={StaticResource BoolToTextConverter}, ConverterParameter='停止轮询|开启轮询'}"/>
                        <Ellipse Width="10" Height="10" Margin="2,0"
                                 Visibility="{Binding IsPulsePolling, Converter={StaticResource BoolToVisConverter}}"
                                 Fill="#E91E63"/>
                        <!-- BPM inline display -->
                        <Border Margin="8,0,0,0" Background="#1A1A2E" CornerRadius="4"
                                Padding="10,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="❤ " Foreground="#E91E63" FontSize="16"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PulseRateText}"
                                           Foreground="#E91E63" FontFamily="Consolas"
                                           FontSize="20" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>
            </WrapPanel>
        </Border>

        <!-- Bottom: Status Bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="采样数: "/>
                    <TextBlock Text="{Binding TotalSamplesReceived}" FontFamily="Consolas"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="缓存: "/>
                    <TextBlock Text="{Binding CacheUsageText}" FontFamily="Consolas"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="滤波: "/>
                    <TextBlock Text="{Binding IsFilterEnabled, Converter={StaticResource BoolToTextConverter}, ConverterParameter='ON|OFF'}"
                               FontFamily="Consolas"
                               Foreground="{Binding IsFilterEnabled, Converter={StaticResource BoolToColorConverter}}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="脉率: "/>
                    <TextBlock Text="{Binding PulseRateText}" FontFamily="Consolas"
                               Foreground="#E91E63"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Center: Waveform Display -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="4"/>
                <RowDefinition Height="*" MinHeight="80"/>
            </Grid.RowDefinitions>

            <!-- Channel 1 Waveform -->
            <GroupBox Grid.Row="0" Header="通道1 (Ch1)" Margin="4">
                <scottPlot:WpfPlot x:Name="WpfPlotCh1"/>
            </GroupBox>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

            <!-- Channel 2 Waveform -->
            <GroupBox Grid.Row="2" Header="通道2 (Ch2)" Margin="4">
                <scottPlot:WpfPlot x:Name="WpfPlotCh2"/>
            </GroupBox>

            <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

            <!-- BPM Waveform -->
            <GroupBox Grid.Row="4" Header="脉率 (BPM)" Margin="4">
                <scottPlot:WpfPlot x:Name="WpfPlotBpm"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
